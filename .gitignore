# ============================================================
# 一、敏感信息（最高优先级）：密钥、凭证、证书
# 理由：.env 存放真实 API Key 和含 authToken 的客服直达地址
#       （JWT 内含手机号），一旦提交将永久留在 git 历史中
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.jks

# ============================================================
# 二、运行日志（用户数据）
# 理由：complaint_bot_*.log 记录真实客服对话内容，属于隐私数据
#       且体积大（单个最大 177KB），对仓库读者无价值
# ============================================================
*.log
logs/

# ============================================================
# 三、Python 运行时可再生文件
# 理由：__pycache__/.pyc 可由源码重新编译生成；虚拟环境
#       体积巨大且应通过 requirements 恢复
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ============================================================
# 四、向量库与模型等大体积可再生文件
# 理由：zto_rag_db/ 是 Chroma 持久化目录，可由 rag_main.py
#       一键重建；模型权重由 sentence-transformers 自动下载
# ============================================================
zto_rag_db/
*.db
*.sqlite3
models/
*.bin
*.pt
*.onnx

# ============================================================
# 五、IDE / 操作系统文件
# 理由：个人编辑器配置与他人无关，系统文件跨平台无意义
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
